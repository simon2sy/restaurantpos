[TEMPLATE]
# Restaurant POS environment configuration template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Django secret key - generate a strong one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to "True" only in local development. Must be "False" in production.
DEBUG=False

# Comma-separated list of allowed hosts, e.g. pos.example.com,www.example.com
ALLOWED_HOSTS=

# PostgreSQL connection settings
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional: comma-separated list of CSRF trusted origins for reverse-proxy
# deployments, e.g. https://pos.example.com
CSRF_TRUSTED_ORIGINS=

# Optional: Redis URL used for Channels (production).
# REDIS_URL=redis://127.0.0.1:6379/0

# CORS allowed origins for React Native app (comma-separated)
# CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081
